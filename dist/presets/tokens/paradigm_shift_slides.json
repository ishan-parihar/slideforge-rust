    "html": "<div style=\"position:relative;width:100%;height:100%;background:var(--surface-dark);background-color:var(--surface-dark);overflow:hidden;\">\n            <div style=\"position: absolute; background: var(--texture-grain); pointer-events: none; opacity: 0.04; z-index: 1; inset: 0\"></div>\n            \n            <div class=\"slide-content\" style=\"position:relative;z-index:10;padding:60px var(--space-6) 60px;display:flex;flex-direction:column;justify-content:center;height:100%;width:100%;box-sizing:border-box;\">\n                <div style=\"width:100%;display:flex;flex-direction:column;gap:12px;\">\n            <h2 style=\"font-family: Plus Jakarta Sans; font-size: 25px; font-weight: 600; line-height: 1.12; color: #F5ECEA; margin: 0 0 12px; text-align: left; letter-spacing: -0.015em; overflow-wrap: break-word\">Structure vs Design: Performance</h2>\n            <div style=\"width:100%;height:195px;border-radius:var(--radius-lg);overflow:hidden;background:rgba(255,255,255,0.05);border:1px solid #3B2924;padding:8px 10px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;\"><svg width=\"100%\" height=\"185px\" viewBox=\"0 0 320 185\" xmlns=\"http://www.w3.org/2000/svg\">\n            <line x1=\"50\" y1=\"147.0\" x2=\"296\" y2=\"147.0\" stroke=\"#3B292444\" stroke-dasharray=\"3,3\" stroke-width=\"1\" /><text x=\"44\" y=\"150.0\" font-size=\"8.5px\" font-weight=\"600\" fill=\"#D7CBC7\" text-anchor=\"end\">22.0</text><line x1=\"50\" y1=\"87.5\" x2=\"296\" y2=\"87.5\" stroke=\"#3B292444\" stroke-dasharray=\"3,3\" stroke-width=\"1\" /><text x=\"44\" y=\"90.5\" font-size=\"8.5px\" font-weight=\"600\" fill=\"#D7CBC7\" text-anchor=\"end\">58.0</text><line x1=\"50\" y1=\"28.0\" x2=\"296\" y2=\"28.0\" stroke=\"#3B292444\" stroke-dasharray=\"3,3\" stroke-width=\"1\" /><text x=\"44\" y=\"31.0\" font-size=\"8.5px\" font-weight=\"600\" fill=\"#D7CBC7\" text-anchor=\"end\">94.0</text><line x1=\"50.0\" y1=\"28\" x2=\"50.0\" y2=\"147\" stroke=\"#3B292444\" stroke-dasharray=\"3,3\" stroke-width=\"1\" /><text x=\"50.0\" y=\"161\" font-size=\"8.5px\" font-weight=\"600\" fill=\"#D7CBC7\" text-anchor=\"middle\">15</text><line x1=\"173.0\" y1=\"28\" x2=\"173.0\" y2=\"147\" stroke=\"#3B292444\" stroke-dasharray=\"3,3\" stroke-width=\"1\" /><text x=\"173.0\" y=\"161\" font-size=\"8.5px\" font-weight=\"600\" fill=\"#D7CBC7\" text-anchor=\"middle\">53</text><line x1=\"296.0\" y1=\"28\" x2=\"296.0\" y2=\"147\" stroke=\"#3B292444\" stroke-dasharray=\"3,3\" stroke-width=\"1\" /><text x=\"296.0\" y=\"161\" font-size=\"8.5px\" font-weight=\"600\" fill=\"#D7CBC7\" text-anchor=\"middle\">91</text>\n            <path d=\"M 72.0 129.0 L 133.1 107.1 L 210.2 70.2 L 274.0 46.0\" fill=\"none\" stroke=\"#E95E3B\" stroke-width=\"2\" stroke-dasharray=\"4,4\" opacity=\"0.6\" />\n            <g>\n                <circle cx=\"72.0\" cy=\"129.0\" r=\"11.5\" fill=\"#E95E3B\" fill-opacity=\"0.85\" stroke=\"white\" stroke-width=\"1.5\" />\n                <text x=\"72.0\" y=\"113.5\" font-size=\"8px\" fill=\"#F5ECEA\" text-anchor=\"middle\" font-weight=\"800\">Template-only</text>\n            </g><g>\n                <circle cx=\"133.1\" cy=\"107.1\" r=\"11.5\" fill=\"#E95E3B\" fill-opacity=\"0.85\" stroke=\"white\" stroke-width=\"1.5\" />\n                <text x=\"133.1\" y=\"91.6\" font-size=\"8px\" fill=\"#F5ECEA\" text-anchor=\"middle\" font-weight=\"800\">Design-led</text>\n            </g><g>\n                <circle cx=\"210.2\" cy=\"70.2\" r=\"11.5\" fill=\"#E95E3B\" fill-opacity=\"0.85\" stroke=\"white\" stroke-width=\"1.5\" />\n                <text x=\"210.2\" y=\"54.7\" font-size=\"8px\" fill=\"#F5ECEA\" text-anchor=\"middle\" font-weight=\"800\">Structure-led</text>\n            </g><g>\n                <circle cx=\"274.0\" cy=\"46.0\" r=\"11.5\" fill=\"#E95E3B\" fill-opacity=\"0.85\" stroke=\"white\" stroke-width=\"1.5\" />\n                <text x=\"274.0\" y=\"30.5\" font-size=\"8px\" fill=\"#F5ECEA\" text-anchor=\"middle\" font-weight=\"800\">Architecture-led</text>\n            </g>\n            <text x=\"173\" y=\"183\" font-size=\"9px\" font-weight=\"800\" fill=\"#D7CBC7\" text-anchor=\"middle\" letter-spacing=\"0.05em\">Emotional Architecture Score</text>\n            <text x=\"50\" y=\"14\" font-size=\"9px\" font-weight=\"800\" fill=\"#D7CBC7\" text-anchor=\"start\" letter-spacing=\"0.05em\">Engagement Rate</text>\n        </svg></div>\n            <p style=\"font-family:Plus Jakarta Sans;font-size:10.5px;color:#D7CBC7;margin:0;line-height:1.4;opacity:0.85;\">Scatter distribution illustrating the linear relationship between character mass and compile latency under concurrency tests.</p>\n        </div>\n            </div>\n        </div>",
