    "html": "<div style=\"position:relative;width:100%;height:100%;background:radial-gradient(at 40% 20%, #BF360C15 0px, transparent 50%), radial-gradient(at 80% 0%, #0083AE10 0px, transparent 50%), radial-gradient(at 0% 50%, #FF936E12 0px, transparent 50%), var(--surface-light);background-color:var(--surface-light);overflow:hidden;\">\n            <div style=\"z-index: 1; position: absolute; background: var(--texture-grain); pointer-events: none; inset: 0; opacity: 0.04\"></div>\n            \n            <div class=\"slide-content\" style=\"position:relative;z-index:10;padding:80px var(--space-6) 80px;display:flex;flex-direction:column;justify-content:center;height:100%;width:100%;box-sizing:border-box;\">\n                <div style=\"width:100%;display:flex;flex-direction:column;justify-content:center;\">\n            <h2 style=\"font-family: Plus Jakarta Sans; font-size: 20px; font-weight: 600; line-height: 1.18; color: #0F0A08; margin: 0 0 12px; text-align: left; letter-spacing: -0.01em; overflow-wrap: break-word\">Engagement by Content Strategy</h2>\n            <div style=\"width:100%;margin-top:16px;\"><div style=\"margin-bottom:16px;width:100%;\">\n                    <div style=\"display:flex;justify-content:space-between;font-family:Plus Jakarta Sans;font-size:12px;font-weight:600;color:#0F0A08;margin-bottom:6px;\">\n                        <span>Template-based</span>\n                        <strong style=\"color:#BF360C;\">23</strong>\n                    </div>\n                    <div style=\"width:100%;height:12px;background:#BF360C22;border-radius:6px;overflow:hidden;\">\n                        <div style=\"width:24.7%;min-width:8px;height:100%;background:#BF360C;border-radius:6px;transition:width 0.3s;\"></div>\n                    </div>\n                </div><div style=\"margin-bottom:16px;width:100%;\">\n                    <div style=\"display:flex;justify-content:space-between;font-family:Plus Jakarta Sans;font-size:12px;font-weight:600;color:#0F0A08;margin-bottom:6px;\">\n                        <span>Design-led</span>\n                        <strong style=\"color:#0083AE;\">38</strong>\n                    </div>\n                    <div style=\"width:100%;height:12px;background:#0083AE22;border-radius:6px;overflow:hidden;\">\n                        <div style=\"width:40.9%;min-width:8px;height:100%;background:#0083AE;border-radius:6px;transition:width 0.3s;\"></div>\n                    </div>\n                </div><div style=\"margin-bottom:16px;width:100%;\">\n                    <div style=\"display:flex;justify-content:space-between;font-family:Plus Jakarta Sans;font-size:12px;font-weight:600;color:#0F0A08;margin-bottom:6px;\">\n                        <span>Structure-led</span>\n                        <strong style=\"color:#BF360C;\">71</strong>\n                    </div>\n                    <div style=\"width:100%;height:12px;background:#BF360C22;border-radius:6px;overflow:hidden;\">\n                        <div style=\"width:76.3%;min-width:8px;height:100%;background:#BF360C;border-radius:6px;transition:width 0.3s;\"></div>\n                    </div>\n                </div><div style=\"margin-bottom:16px;width:100%;\">\n                    <div style=\"display:flex;justify-content:space-between;font-family:Plus Jakarta Sans;font-size:12px;font-weight:600;color:#0F0A08;margin-bottom:6px;\">\n                        <span>Architecture-led</span>\n                        <strong style=\"color:#4A403D;\">93</strong>\n                    </div>\n                    <div style=\"width:100%;height:12px;background:#4A403D22;border-radius:6px;overflow:hidden;\">\n                        <div style=\"width:100.0%;min-width:8px;height:100%;background:#4A403D;border-radius:6px;transition:width 0.3s;\"></div>\n                    </div>\n                </div></div>\n            \n        </div>\n            </div>\n        </div>",
