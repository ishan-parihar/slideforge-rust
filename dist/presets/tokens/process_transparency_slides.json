s;\">\n                    Rendered HTML\n                </div>\n            </div><div style=\"position:relative;width:100%;height:100%;overflow:hidden;\">\n                <div style=\"position:relative;width:100%;height:100%;border-radius: 0;overflow:hidden;background:transparent;box-sizing:border-box;\">\n                <img src=\"https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600\" alt=\"Exported PNG\" style=\"display:block;width:100%;height:100%;object-fit: cover; object-position: center;filter: contrast(1.02) brightness(1.02);\" />\n                \n            </div>\n                <div style=\"padding:5px 8px;background:rgba(0,0,0,0.62);position:absolute;top:8px;left:8px;max-width:calc(100% - 16px);z-index:3;color:white;font-family:DM Sans;font-size:10px;font-weight:800;text-align:left;border-radius:999px;letter-spacing:0.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">\n                    Exported PNG\n                </div>\n            </div>\n                </div>\n            <div style=\"font-family:DM Sans;font-size:11.5px;color:#4A3F3E;margin-top:10px;line-height:1.35;width:100%;opacity:0.9;\">From tokens to pixels \u2014 every intermediate step is inspectable</div>\n        </div>\n            </div>\n        </div>",
