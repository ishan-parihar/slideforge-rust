    "html": "<div style=\"position:relative;width:100%;height:100%;background:var(--surface-dark);background-color:var(--surface-dark);overflow:hidden;\">\n            <div style=\"background: var(--texture-grain); pointer-events: none; z-index: 1; opacity: 0.04; position: absolute; inset: 0\"></div>\n            \n            <div class=\"slide-content\" style=\"position:relative;z-index:10;padding:60px var(--space-6) 60px;display:flex;flex-direction:column;justify-content:center;height:100%;width:100%;box-sizing:border-box;\">\n                <div style=\"width:100%;display:flex;flex-direction:column;justify-content:center;\">\n            <h2 style=\"font-family: Plus Jakarta Sans; font-size: 25px; font-weight: 600; line-height: 1.12; color: var(--text-primary, #0B0A0F); margin: 0; text-align: left; letter-spacing: -0.015em; overflow-wrap: break-word\">Speed Comparison</h2><div style=\"width:100%;margin-top:20px;\">\n            <div style=\"font-family:Plus Jakarta Sans;font-size:11px;font-weight:800;color:#EA542B;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px;text-align:center;width:100%;\">Time to First Carousel</div>\n            <div style=\"display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:8px;font-family:Plus Jakarta Sans;font-size:11px;color:#F5ECEA;font-weight:700;line-height:1.2;\">\n                <span style=\"text-align:left;max-width:48%;overflow-wrap:break-word;\">Entity A</span>\n                <span style=\"text-align:right;max-width:48%;overflow-wrap:break-word;\">Entity B</span>\n            </div>\n            <div style=\"width:100%;height:16px;background:#3B292330;border-radius:8px;overflow:hidden;display:flex;\">\n                <div style=\"width:13.6%;height:100%;background:#EA542B;border-radius:8px 0 0 8px;\"></div>\n                <div style=\"width:86.4%;height:100%;background:#D7CBC7;border-radius:0 8px 8px 0;\"></div>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:10px;font-family:Plus Jakarta Sans;font-size:15px;font-weight:800;letter-spacing:-0.01em;line-height:1.2;\">\n                <span style=\"color:#EA542B;text-align:left;white-space:nowrap;flex-shrink:0;\">15 Time to First Carousel</span>\n                <span style=\"color:#D7CBC7;text-align:right;white-space:nowrap;flex-shrink:0;\">95 Time to First Carousel</span>\n            </div>\n        </div>\n        </div>\n            </div>\n        </div>",
