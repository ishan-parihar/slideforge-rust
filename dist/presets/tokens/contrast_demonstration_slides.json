    "html": "<div style=\"position:relative;width:100%;height:100%;background:var(--surface-dark);background-color:var(--surface-dark);overflow:hidden;\">\n            <div style=\"position: absolute; inset: 0; background: var(--texture-grain); opacity: 0.04; z-index: 1; pointer-events: none\"></div>\n            <div style=\"position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1;\"><div style=\"height: 320px; border-radius: 50%; background: #CD3801; top: -80px; pointer-events: none; opacity: 0.07; position: absolute; width: 320px; left: -80px\"></div><div style=\"background: #008BBC; position: absolute; border-radius: 4px; opacity: 0.05; width: 120px; left: auto; right: -40px; pointer-events: none; transform: rotate(60deg); height: 120px; top: 60%\"></div></div>\n            <div class=\"slide-content\" style=\"position:relative;z-index:10;padding:60px var(--space-6) 60px;display:flex;flex-direction:column;justify-content:center;height:100%;width:100%;box-sizing:border-box;\">\n                <span style=\"background: linear-gradient(135deg, #FFFFFF 0%, #F5ECEA 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-family: Plus Jakarta Sans; font-size: 31px; font-weight: 600; line-height: 1.08; text-align: left; margin: 0; display: block; letter-spacing: -0.02em\">Manual Design vs. Nexus Composition</span><p style=\"font-family: Plus Jakarta Sans; font-size: 16px; font-weight: 400; line-height: 1.55; color: #D7CBC7; margin: 8px 0 0; text-align: left\">Same goal. Radically different outcomes.</p>\n            </div>\n        </div>",
