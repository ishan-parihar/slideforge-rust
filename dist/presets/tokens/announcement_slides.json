    "html": "<div style=\"position:relative;width:100%;height:100%;background:var(--surface-dark);background-color:var(--surface-dark);overflow:hidden;\">\n            <div style=\"z-index: 1; background: var(--texture-grain); pointer-events: none; position: absolute; inset: 0; opacity: 0.04\"></div>\n            <div style=\"position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1;\"><div style=\"width: 320px; pointer-events: none; border-radius: 50%; position: absolute; top: -80px; opacity: 0.07; height: 320px; background: #5E5FE0; left: -80px\"></div><div style=\"left: auto; top: 60%; height: 120px; opacity: 0.05; pointer-events: none; transform: rotate(60deg); background: #937000; width: 120px; border-radius: 4px; right: -40px; position: absolute\"></div></div>\n            <div class=\"slide-content\" style=\"position:relative;z-index:10;padding:60px var(--space-6) 60px;display:flex;flex-direction:column;justify-content:center;height:100%;width:100%;box-sizing:border-box;\">\n                <div style=\"display: inline-block; padding: 6px 16px; background: #7478FC15; border: 1px solid #7478FC30; border-radius: 9999px; font-family: DM Sans; font-size: 13px; font-weight: 600; color: #7478FC; letter-spacing: 0.05em; text-transform: uppercase; margin: 0 0 16px;\">JUST SHIPPED</div><span style=\"background: linear-gradient(135deg, #FFFFFF 0%, #EDEEF5 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-family: Playfair Display; font-size: 31px; font-weight: 600; line-height: 1.08; text-align: left; margin: 0; display: block; letter-spacing: -0.02em\">Introducing Nexus 3.0</span><p style=\"font-family: DM Sans; font-size: 16px; font-weight: 400; line-height: 1.55; color: #CBCDD8; margin: 8px 0 0; text-align: left\">The slide engine that writes itself. Describe what you need. Nexus builds the carousel.</p>\n            </div>\n        </div>",
