    <p style=\"font-family:Plus Jakarta Sans;font-size:12px;font-weight:800;color:white;margin:0;text-transform:uppercase;letter-spacing:0.08em;text-shadow:0 2px 8px rgba(0,0,0,0.75);\">Pierre Teilhard de Chardin</p>\n                \n            </div>\n        </div>\n            </div>\n        </div>",
