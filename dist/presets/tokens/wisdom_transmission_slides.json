    "html": "<div style=\"position:relative;width:100%;height:100%;background:radial-gradient(at 40% 20%, #6A1B9A15 0px, transparent 50%), radial-gradient(at 80% 0%, #2C5C0010 0px, transparent 50%), radial-gradient(at 0% 50%, #B66EED12 0px, transparent 50%), var(--surface-light);background-color:var(--surface-light);overflow:hidden;\">\n            <div style=\"background: var(--texture-grain); inset: 0; opacity: 0.04; position: absolute; pointer-events: none; z-index: 1\"></div>\n            \n            <div class=\"slide-content\" style=\"position:relative;z-index:10;padding:72px 44px;display:flex;flex-direction:column;justify-content:center;height:100%;width:100%;box-sizing:border-box;\">\n                <div style=\"width:100%;background:rgba(255,255,255,0.92);border:1px solid #CDC8D2;border-radius:0;padding:22px 20px;box-sizing:border-box;display:flex;flex-direction:column;gap:4px;\">\n            <span style=\"font-family:Plus Jakarta Sans;font-size:9.5px;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#6A1B9A;background:#6A1B9A18;padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:8px;\">CORE DEFINITION</span>\n            <h2 style=\"font-family:Plus Jakarta Sans;font-size:28px;font-weight:900;color:#0C0A0E;margin:0 0 4px;line-height:1.1;\">Dharma</h2>\n            <div style=\"font-family:Plus Jakarta Sans;font-size:11px;font-style:italic;color:#454049;margin-bottom:12px;opacity:0.8;\">/\u02c8d\u0251\u02d0rm\u0259/</div>\n            <div style=\"border-left:3px solid #6A1B9A;padding-left:14px;margin:12px 0 14px;\">\n            <p style=\"font-family:Plus Jakarta Sans;font-size:13px;font-weight:500;color:#0C0A0E;margin:0;line-height:1.5;\">The cosmic order that sustains the universe. In communication, dharma is the truth that exists beneath the surface of words \u2014 the message that the audience already knows but hasn&#x27;t yet articulated.</p>\n        </div>\n            <p style=\"font-family:Plus Jakarta Sans;font-size:10.5px;color:#454049;margin:0;line-height:1.4;opacity:0.85;\">Teaching isn&#x27;t about filling empty vessels. It&#x27;s about helping people remember what they already know.</p>\n        </div>\n            </div>\n        </div>",
