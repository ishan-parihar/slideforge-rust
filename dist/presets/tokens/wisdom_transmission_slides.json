    "html": "<div style=\"position:relative;width:100%;height:100%;background:radial-gradient(at 40% 20%, #6A1B9A15 0px, transparent 50%), radial-gradient(at 80% 0%, #2C5C0010 0px, transparent 50%), radial-gradient(at 0% 50%, #B66EED12 0px, transparent 50%), var(--surface-light);background-color:var(--surface-light);overflow:hidden;\">\n            <div style=\"background: var(--texture-grain); z-index: 1; opacity: 0.04; position: absolute; pointer-events: none; inset: 0\"></div>\n            \n            <div class=\"slide-content\" style=\"position:relative;z-index:10;padding:80px 48px var(--space-12);display:flex;flex-direction:column;justify-content:center;height:100%;width:100%;box-sizing:border-box;\">\n                <div style=\"max-width:320px;margin:0 auto;text-align:left;width:100%;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;height:100%;overflow:hidden;padding-bottom:var(--space-2);\">\n            <h2 style=\"font-family:Plus Jakarta Sans;font-size:22px;font-weight:700;color:#0C0A0E;margin:0 0 16px;line-height:1.2;\">The Second Teaching</h2>\n            <div style=\"margin-top:4px;\"><p style=\"font-family:Plus Jakarta Sans;font-size:14px;color:#454049;margin:0 0 12px;line-height:1.6;\">Simplicity is not the absence of complexity \u2014 it&#x27;s the mastery of it. The most profound ideas can be expressed in one slide. If you need ten slides to explain something, you haven&#x27;t understood it yet.</p></div>\n        </div>\n            </div>\n        </div>",
