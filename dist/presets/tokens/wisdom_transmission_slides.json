    "html": "<div style=\"position:relative;width:100%;height:100%;background:var(--surface-dark);background-color:var(--surface-dark);overflow:hidden;\">\n            <div style=\"inset: 0; background: var(--texture-grain); pointer-events: none; z-index: 1; opacity: 0.04; position: absolute\"></div>\n            \n            <div class=\"slide-content--bleed\" style=\"position:relative;z-index:10;padding:0;display:flex;flex-direction:column;justify-content:stretch;height:100%;width:100%;box-sizing:border-box;\">\n                <div style=\"position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center;\">\n            <div style=\"position:relative;width:100%;height:100%;border-radius: 0;overflow:hidden;background:transparent;box-sizing:border-box;\">\n                <img src=\"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100\" alt=\"The teacher who is indeed wise does not bid you to enter the house of his wisdom, but rather leads you to the threshold of your mind.\" style=\"display:block;width:100%;height:100%;object-fit: cover; object-position: center;filter: contrast(1.06) brightness(1.06);\" />\n                <div style=\"position:absolute;inset:0;background:linear-gradient(to bottom, rgba(0,0,0,0.15), rgba(0,0,0,0.68));z-index:2;\"></div>\n            </div>\n            <div style=\"position:absolute;inset:0;padding:60px 28px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;z-index:3;\">\n                <div style=\"font-size:36px;color:white;line-height:1;margin-bottom:8px;font-weight:bold;opacity:0.85;text-shadow:0 2px 8px rgba(0,0,0,0.75);\">\u201c</div>\n                <p style=\"font-family:Plus Jakarta Sans;font-size:22px;font-style:italic;font-weight:600;color:white;margin:0 0 16px;line-height:1.4;max-width:380px;text-shadow:0 2px 10px rgba(0,0,0,0.85);\">The teacher who is indeed wise does not bid you to enter the house of his wisdom, but rather leads you to the threshold of your mind.</p>\n                <p style=\"font-family:Plus Jakarta Sans;font-size:12px;font-weight:800;color:white;margin:0;text-transform:uppercase;letter-spacing:0.08em;text-shadow:0 2px 8px rgba(0,0,0,0.75);\">Khalil Gibran</p>\n                \n            </div>\n        </div>\n            </div>\n        </div>",
