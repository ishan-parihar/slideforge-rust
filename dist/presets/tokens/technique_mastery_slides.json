  {
    "html": "<div style=\"position:relative;width:100%;height:100%;background:var(--surface-dark);background-color:var(--surface-dark);overflow:hidden;\">\n            <div style=\"position: absolute; opacity: 0.04; inset: 0; background: var(--texture-grain); pointer-events: none; z-index: 1\"></div>\n            \n            <div class=\"slide-content\" style=\"position:relative;z-index:10;padding:80px var(--space-6) 80px;display:flex;flex-direction:column;justify-content:center;height:100%;width:100%;box-sizing:border-box;\">\n                <div style=\"width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;\">\n            <div style=\"position:relative;width:100%;height:230px;border-radius:var(--radius-md);overflow:hidden;box-shadow:0 6px 20px rgba(0,0,0,0.15);border:1px solid #312F1D30;\">\n                <div style=\"position:relative;width:100%;height:240px;border-radius: var(--radius-sm);overflow:hidden;background:transparent;box-sizing:border-box;\">\n                <img src=\"https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=600\" alt=\"Annotated Diagram\" style=\"display:block;width:100%;height:100%;object-fit: cover; object-position: center;filter: contrast(1.06) brightness(1.06);\" />\n                \n            </div>\n                \n            </div>\n            <p style=\"font-family:Plus Jakarta Sans;font-size:12px;color:#CFCEC3;margin:10px 0 0;line-height:1.45;opacity:0.9;\">The best slides don&#x27;t show everything \u2014 they leave room for the audience&#x27;s imagination.</p>\n            <div style=\"margin-top:10px;display:flex;flex-direction:column;gap:4px;width:100%;\"><div style=\"font-family:Plus Jakarta Sans;font-size:12px;color:#CFCEC3;line-height:1.45;\">\n                        <strong style=\"color:#EFEFE7;font-weight:700;\">Transportation happens in the gap</strong> \u2014 The space between what you say and what the audience imagines is where persuasion lives\n                    </div></div>\n        </div>\n            </div>\n        </div>",
